# Template for local credentials. Copy it, then fill in the values:
#
#   cp src/test/resources/config/public.secrets.properties.example \
#      src/test/resources/config/public.secrets.properties
#
# Files named *.secrets.properties are git-ignored and docker-ignored.
# Use <env>.secrets.properties for other environments, e.g. local.secrets.properties.
# Restful-Booker's demo credentials are listed in its public API docs.
admin.username=
admin.password=
